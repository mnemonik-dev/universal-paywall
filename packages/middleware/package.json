{
  "name": "@universal-paywall/middleware",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "//test": "keep --passWithNoTests until T6 lands first vitest test; do not remove",
    "//test-env": "UP_SUPPRESS_T3_NOTES=1 silences the T3 USDC-domain boot warnings (gas-fallback / arc-dual-decimal) that fire on every networks.ts module load. Operators still see them outside the test runner.",
    "test": "UP_SUPPRESS_T3_NOTES=1 vitest run --passWithNoTests",
    "test:coverage": "UP_SUPPRESS_T3_NOTES=1 vitest run --coverage",
    "test:e2e": "UP_SUPPRESS_T3_NOTES=1 vitest run src/__tests__/integration/ --passWithNoTests",
    "//audit-vitest": "vitest upgraded to ^3.2.7 to resolve GHSA-4w7w-66w2-5vf9 and related vite advisories",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@universal-paywall/facilitator": "*",
    "viem": "^2.55.1"
  },
  "peerDependencies": {
    "fastify": "^5.10.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.12.0",
    "fastify": "^5.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
