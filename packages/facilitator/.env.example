# ============================================================
# up-facilitator  (legacy metered batching against StakeVault)
# ============================================================

# --- Network / Chain ---
# RPC endpoint for the Arc network (testnet default shown)
ARC_RPC_URL=https://rpc.testnet.arc.io
# EVM chain ID matching ARC_RPC_URL (Arc testnet = 5042002)
CHAIN_ID=5042002

# Arc mainnet RPC endpoint (use instead of the testnet pair above)
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# Network identifier string for Arc mainnet
ARC_MAINNET_NETWORK=arc-mainnet

# --- Contracts ---
# Deployed StakeVaultFactory address
STAKE_VAULT_FACTORY=0xYourStakeVaultFactoryAddress

# --- Keys ---
# Private key (0x-prefixed) of the facilitator hot wallet used to submit settlements
FACILITATOR_KEY=0xYourFacilitatorPrivateKey

# --- Auth ---
# Comma-separated list of API keys accepted by the facilitator HTTP API
FACILITATOR_API_KEYS=your-api-key-1,your-api-key-2

# --- Batching (optional) ---
# Maximum number of charges to include in a single settlement batch (default: 50)
BATCH_MAX_CHARGES=50
# Maximum age in milliseconds before a pending batch is force-flushed (default: 15000)
BATCH_MAX_AGE_MS=15000

# --- Server (optional) ---
# Port the up-facilitator HTTP server listens on (default: 8402)
PORT=8402


# ============================================================
# up-session-facilitator  (V1 synchronous paid sessions)
# ============================================================

# --- Network / Chain ---
# RPC endpoint (same variable used by both facilitators, testnet default shown)
# ARC_RPC_URL=https://rpc.testnet.arc.io
# EVM chain ID — must match ARC_RPC_URL
# CHAIN_ID=5042002

# Network identifier string sent in session quotes/receipts (e.g. eip155:5042002)
NETWORK=eip155:5042002

# --- Contracts ---
# Deployed SessionStakeVaultFactory address
SESSION_STAKE_VAULT_FACTORY=0xYourSessionStakeVaultFactoryAddress
# USDC token contract address on the target chain
USDC_ADDRESS=0xYourUSDCAddress

# --- Keys ---
# Private key (0x-prefixed) for the session facilitator hot wallet
# FACILITATOR_KEY=0xYourFacilitatorPrivateKey

# --- Service identity ---
# Stable identifier for this service (included in scope hashes and receipts)
SERVICE_ID=mnemonic
# Wallet address that receives settled USDC payments
SERVICE_PAY_TO=0xYourServicePayToAddress

# --- Auth ---
# Comma-separated list of API keys for the session facilitator HTTP API
SERVICE_API_KEYS=your-session-api-key

# --- Receipts ---
# Path to the Ed25519 private key PEM file (must be chmod 0600)
RECEIPT_PRIVATE_KEY_FILE=./receipt-ed25519.pem
# Stable key identifier embedded in issued receipts (rotate on key change)
RECEIPT_KEY_ID=prod-1

# --- EIP-3009 exact payments (required when EXACT_PAYMENTS_ENABLED=1) ---
# Enable the exact x402 EIP-3009 payment path (must be 1 to start the server)
EXACT_PAYMENTS_ENABLED=1
# EIP-712 domain name for USDC on the target chain (check the token deployment)
USDC_EIP712_NAME=USD Coin
# EIP-712 domain version for USDC on the target chain
USDC_EIP712_VERSION=2

# --- Session / quote limits (optional) ---
# Lifetime of a quote in seconds before it expires (default: 300, max: 86400)
QUOTE_TTL_SECONDS=300
# Maximum allowed session length in seconds (default: 604800 = 7 days, max: 31536000)
MAX_SESSION_SECONDS=604800
# First block to scan when reconciling session rail events on-chain (default: 0)
SESSION_RAIL_FROM_BLOCK=0

# --- Persistence ---
# Path to the JSON file used by the built-in single-writer payment store
PAYMENT_STORE_PATH=./data/payments.json

# --- Server (optional) ---
# Port the up-session-facilitator HTTP server listens on (default: 8403)
# PORT=8403
