{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-paywall.example/schemas/payment-receipt.v1.schema.json",
  "title": "Universal Paywall Payment Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "scheme",
    "status",
    "binding_digest",
    "payer_wallet",
    "amount",
    "asset",
    "network",
    "pay_to",
    "settlement_tx",
    "settled_at",
    "receipt"
  ],
  "properties": {
    "operation_id": { "type": "string", "minLength": 1 },
    "scheme": { "enum": ["stake", "exact"] },
    "status": { "const": "settled" },
    "binding_digest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "payer_wallet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "amount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "asset": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "network": { "type": "string", "pattern": "^eip155:[0-9]+$" },
    "pay_to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "settlement_tx": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "settled_at": { "type": "string", "format": "date-time" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signature"],
      "properties": {
        "payload": { "type": "object" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": { "const": "Ed25519" },
            "key_id": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 80 }
          }
        }
      }
    }
  }
}
