{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-paywall.example/schemas/session-authorization.v1.schema.json",
  "title": "Universal Paywall Session Authorization V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization", "signature"],
  "properties": {
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "service_id",
        "session_id",
        "payer_subject",
        "payer_wallet",
        "vault",
        "facilitator",
        "pay_to",
        "cap",
        "per_operation_ceiling",
        "valid_until",
        "network",
        "asset",
        "policy_epoch",
        "workspace_hash",
        "visibility",
        "allowed_actions",
        "nonce"
      ],
      "properties": {
        "version": { "const": 1 },
        "service_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "payer_subject": { "type": "string", "minLength": 1 },
        "payer_wallet": { "$ref": "#/$defs/address" },
        "vault": { "$ref": "#/$defs/address" },
        "facilitator": { "$ref": "#/$defs/address" },
        "pay_to": { "$ref": "#/$defs/address" },
        "cap": { "$ref": "#/$defs/uint" },
        "per_operation_ceiling": { "$ref": "#/$defs/uint" },
        "valid_until": { "type": "string", "format": "date-time" },
        "network": { "type": "string", "pattern": "^eip155:[0-9]+$" },
        "asset": { "$ref": "#/$defs/address" },
        "policy_epoch": { "$ref": "#/$defs/uint" },
        "workspace_hash": { "$ref": "#/$defs/bytes32" },
        "visibility": { "type": "string", "minLength": 1 },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["manual", "pre_compaction", "session_end"] }
        },
        "nonce": { "$ref": "#/$defs/bytes32" }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "uint": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
